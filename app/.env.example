DATABASE_PATH=./data/surface_map.db
AI_PROVIDER=rules-demo
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
MAX_CRAWL_PAGES=12
MAX_CRAWL_DEPTH=2
REQUEST_DELAY_SECONDS=0.25
ENABLE_RDAP=false

# Optional Google Custom Search JSON API access for Google Dork result collection.
# The API is closed to new customers; see docs/verification/GOOGLE_DORK.md.
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_ID=

# Only for explicitly declared private lab scopes
ALLOW_PRIVATE_LAB=false

# Browser frontend origins allowed to call the API on port 3333
CORS_ORIGINS=http://127.0.0.1:2222,http://localhost:2222
